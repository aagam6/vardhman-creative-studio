{
  "name": "monorepo",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others --raw \"npm run dev --prefix apps/web\" \"npm run dev --prefix apps/pocketbase\"",
    "build": "concurrently --raw \"npm run build --prefix apps/web\"",
    "start": "concurrently --kill-others --raw \"npm run start --prefix apps/pocketbase\"",
    "lint": "concurrently --raw \"npm run lint --prefix apps/web\""
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "vite": "^6.4.3",
    "@vitejs/plugin-react": "^4.3.4"
  },
  "workspaces": [
    "apps/*"
  ],
  "overrides": {
    "brace-expansion": "^5.0.9",
    "shell-quote": "^1.10.0",
    "postcss": "^8.5.18",
    "react-router": "^7.18.2",
    "react-router-dom": "^7.18.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "js-yaml": "^4.3.1",
    "esbuild": "^0.25.0",
    "dompurify": "^3.4.13",
    "nanoid": "^3.3.17",
    "vite": "^6.4.3"
  }
}