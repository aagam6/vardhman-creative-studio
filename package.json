{
  "name": "monorepo",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others --raw \"npm run dev --prefix apps/web\" \"npm run start --prefix apps/api\"",
    "build": "concurrently --raw \"npm run build --prefix apps/web\"",
    "start": "npm run start --prefix apps/api",
    "lint": "concurrently --raw \"npm run lint --prefix apps/web\"",
    "test": "npm run test --prefix apps/api && npm run test --prefix apps/web",
    "postinstall": "node tools/production-postinstall.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.4",
    "vite": "^6.4.4"
  },
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "overrides": {
    "source-map-js": "^1.2.2",
    "brace-expansion": "^5.0.12",
    "shell-quote": "^1.11.0",
    "postcss": "^8.5.18",
    "react-router-dom": {
      "react-router": "^8.3.0"
    },
    "react-router": "^8.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "js-yaml": "^4.3.2",
    "esbuild": "^0.28.2",
    "dompurify": "^3.4.16",
    "nanoid": "^3.3.17",
    "vite": "$vite"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
