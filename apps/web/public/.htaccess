<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteBase /

	# Collapse duplicate slashes
	RewriteCond %{THE_REQUEST} \s[^?]*//
	RewriteRule ^(.*)$ /$1 [R=301,L]

	# Remove trailing slash except for directories
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteRule ^(.*)/$ /$1 [R=301,L]

	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
	Header set X-Powered-By "Hostinger Horizons"

	# Cache everything on CDN by default
	Header set Cache-Control "public, s-maxage=604800, max-age=0"

	# Cache in browser all assets for 1 year (immutable hashed files)
	<If "%{REQUEST_URI} =~ m#^/assets/.*$#">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</If>

	# Dynamic APIs and private Ayambil pages must override the CDN default.
	# Clear both header tables so proxied responses never retain a public value.
	<If "%{REQUEST_URI} =~ m#^/(?:api(?:/|$)|hcgi/platform(?:/|$)|admin/ayambil(?:/|$)|500-akhand-ayambil-vijayollas/passes(?:/|$))#">
		Header unset Cache-Control
		Header always unset Cache-Control
		Header always set Cache-Control "private, no-store, max-age=0, must-revalidate"
		Header always set CDN-Cache-Control "no-store"
		Header always set Surrogate-Control "no-store"
		Header always set Pragma "no-cache"
		Header always set Expires "0"
	</If>
</IfModule>
