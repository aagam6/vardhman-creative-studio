<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteBase /

	# Collapse duplicate slashes
	RewriteCond %{THE_REQUEST} \s[^?]*//
	RewriteRule ^(.*)$ /$1 [R=301,L]

	# Remove trailing slash except for directories
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteRule ^(.*)/$ /$1 [R=301,L]

	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_setenvif.c>
	# Use the original request path before the SPA/Passenger rewrite.
	SetEnvIf Request_URI "^/(api(/|$)|hcgi/platform(/|$)|admin/ayambil(/|$)|500-akhand-ayambil-vijayollas/(passes|respond)(/|$))" AYAMBIL_NOSTORE=1
</IfModule>

<IfModule mod_headers.c>
	Header set X-Powered-By "Hostinger Horizons"

	# Cache everything on CDN by default
	Header set Cache-Control "public, s-maxage=604800, max-age=0" env=!AYAMBIL_NOSTORE

	# Cache in browser all assets for 1 year (immutable hashed files)
	<If "%{REQUEST_URI} =~ m#^/assets/.*$#">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</If>

	# Dynamic APIs and private Ayambil pages must override the CDN default.
	# Clear both header tables so proxied responses never retain a public value.
	Header unset Cache-Control env=AYAMBIL_NOSTORE
	Header always unset Cache-Control env=AYAMBIL_NOSTORE
	Header always set Cache-Control "private, no-store, max-age=0, must-revalidate" env=AYAMBIL_NOSTORE
	Header always set CDN-Cache-Control "no-store" env=AYAMBIL_NOSTORE
	Header always set Surrogate-Control "no-store" env=AYAMBIL_NOSTORE
	Header always set Pragma "no-cache" env=AYAMBIL_NOSTORE
	Header always set Expires "0" env=AYAMBIL_NOSTORE
</IfModule>
